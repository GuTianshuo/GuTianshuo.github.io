<article id="<%= post.layout %>-<%= post.slug %>" class="h-entry article article-type-<%= post.layout %>" itemprop="blogPost" itemscope itemtype="https://schema.org/BlogPosting">
  <div class="article-meta">
    <%- partial('post/date', {class_name: 'article-date', date_format: null}) %>
    <%- partial('post/category') %>
  </div>
  <div class="article-inner">
    <%- partial('post/gallery') %>
    <% if (post.link || post.title){ %>
      <header class="article-header">
        <%- partial('post/title', {class_name: 'p-name article-title'}) %>
      </header>
    <% } %>
    <% if (!index){ %>
      <div class="article-toolbar">
        <div class="article-poll" id="article-poll">
          <span class="poll-title">你觉得这篇怎么样？</span>
          <button type="button" class="poll-opt" data-opt="helpful" title="有帮助">👍 有帮助</button>
          <button type="button" class="poll-opt" data-opt="unhelpful" title="没帮助">👎 没帮助</button>
          <button type="button" class="poll-opt" data-opt="hate" title="讨厌我">😠 讨厌我</button>
          <button type="button" class="poll-opt" data-opt="learned" title="学到了">🎓 学到了</button>
          <button type="button" class="poll-opt" data-opt="poop" title="丢大便">💩 丢大便</button>
          <span class="poll-result"></span>
        </div>
        <button type="button" id="translate-btn" class="article-translate-btn" data-i18n="translate-btn">🌐 翻译文章</button>
      </div>
    <% } %>
    <div class="e-content article-entry" itemprop="articleBody">
      <% if (post.excerpt && index){ %>
        <%- post.excerpt %>
        <% if (theme.excerpt_link){ %>
          <p class="article-more-link">
            <a href="<%- url_for(post.path) %>#more"><%= theme.excerpt_link %></a>
          </p>
        <% } %>
      <% } else { %>
        <%- post.content %>
      <% } %>
    </div>
    <footer class="article-footer">
      <a data-url="<%- post.permalink %>" data-id="<%= post._id %>" data-title="<%= post.title %>" class="article-share-link"><span class="fa fa-share" data-i18n="share"><%= __('share') %></span></a>
      <% if (post.comments && theme.disqus_shortname){ %>
        <a href="<%- post.permalink %>#disqus_thread" class="article-comment-link"><span class="fa fa-comment"><%= __('comment') %></span></a>
      <% } %>
      <% if (post.comments && theme.valine.enable && theme.valine.appId && theme.valine.appKey ){ %>
        <a href="<%- url_for(post.path) %>#comments" class="article-comment-link">
          <span class="post-comments-count valine-comment-count fa fa-comment" data-xid="<%- url_for(post.path) %>" itemprop="commentCount"></span>
          <%= __('comment') %>
        </a>
      <% } %>
      <%- partial('post/tag') %>
    </footer>
  </div>
  <% if (!index){ %>
    <%- partial('post/nav') %>
  <% } %>
</article>

<% if (!index && post.comments){ %>
<section id="comments">
  <div class="giscus"></div>
  <script src="https://giscus.app/client.js"
          data-repo="GuTianshuo/GuTianshuo.github.io"
          data-repo-id="R_kgDOTw18fA"
          data-category="Announcements"
          data-category-id="DIC_kwDOTw18fM4DC2fw"
          data-mapping="pathname"
          data-strict="0"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="bottom"
          data-theme="preferred_color_scheme"
          data-lang="zh-CN"
          crossorigin="anonymous"
          async>
  </script>
</section>
<% } %>

<% if (!index && post.comments && theme.disqus_shortname){ %>
<section id="comments">
  <div id="disqus_thread">
    <noscript>Please enable JavaScript to view the <a href="//disqus.com/?ref_noscript">comments powered by Disqus.</a></noscript>
  </div>
</section>
<% } %>
<% if (!index && post.comments && theme.valine.enable && theme.valine.appId && theme.valine.appKey){ %>
  <section id="comments" class="vcomment">

  </section>
<% } %>